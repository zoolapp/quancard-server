{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": { "includes": ["**", "!**/dist", "!**/node_modules", "!vectors/*.json", "!**/coverage", "!**/test-results", "!**/playwright-report"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noControlCharactersInRegex": "off" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "double" } }
}
